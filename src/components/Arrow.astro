---
const { arrow_class } = Astro.props;
---

<img class={arrow_class} src="/public/imgs/Program/numbers/arrow.svg" alt="arrow" />

<style>
  img {
    width: 35px;
  }
  /*Hvis du tilføjer en klasse til arrow fx. class="up", så vil arrow være roteret korrekt*/
  .left {
    transform: rotate(180deg);
  }

  .right {
    transform: rotate(0deg);
  }
  .down {
    transform: rotate(90deg);
  }
  .up {
    transform: rotate(-90deg);
  }
  .downleft {
    transform: rotate(45deg);
  }
</style>
