        <img
          class="practical_img_1"
          src="/imgs/burger/green_1.png"
          alt="burger"
        />
        <img
          class="practical_img_2"
          src="/imgs/burger/green_2.png"
          alt="burger"
        />
        <img
          class="practical_img_3"
          src="/imgs/burger/green_3.png"
          alt="burger"
        />
