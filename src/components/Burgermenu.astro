</header>
<style>
  /*HEADER*/

  /*position og brede af header*/
  header {
    width: 100%;
    position: fixed;
    transition: 0.4s;
    animation: 0.4s opacity ease-in-out;
  }

  /*styling af tekst*/

  /*styling der skal forblive ens i lukket/åben*/
  a {
    font-family: "GeneralSans", sans-serif;
    font-style: normal;
    color: var(--black);
    text-align: center;
    text-decoration: none;
  }
  /*styling af lukket*/
  .visible_tab {
    font-size: 18px;
    font-weight: 600;
  }
  /*styling af åben burger*/
  .burger_tab {
    font-size: 80px;
    font-weight: 500;
  }

  /*STYLING AF LUKKET MENU*/
  .burger {
    display: none;
  }

  /**** MENUBAR *****/
  .menubar {
    display: flex;
    height: 60px;
    padding: 0px 40px;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    border-bottom: 1px solid var(--Black, #060604); /*tilføj border*/
    box-shadow: 0px 3px 10px 5px rgba(33, 34, 26, 0.2); /*tilføj shadow*/
  }

  .left_row {
    border-right: 1px solid var(--Black, #060604);
    padding-right: 40px;
    height: 100%;
    align-self: stretch;
    display: flex;
    align-items: center;
  }
  /*styling af højre side af menuen*/
  .right_row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    height: 100%; /*sørger for at linjerne er 100% højde - ved at gøre hele objekted 100% høj*/
  }

  /*styling af visible_tabs*/
  .visible_tab {
    padding: 0px 40px;
    border-left: 1px solid var(--Black, #060604);
    height: 100%; /*sørger for at linjerne er 100% højde - ved at gøre hele objekted 100% høj*/
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  /**** BURGER IKON OG KRYDS *****/

  /*Styling af ikon holder - primært layout*/
  .ikon_holder {
    height: 100%; /*sørger for at linjerne er 100% højde - ved at gøre hele objekted 100% høj*/
    align-self: stretch;
    display: flex;
    align-items: center;
    padding-left: 40px;
    width: 40px;
    border-left: 1px solid var(--Black, #060604);
  }
  /*Styling af burgerikon*/
  .line1,
  .line2 {
    width: 40px;
    height: 2px;
    background-color: var(--black);
    margin: 15px 0;
    transition: 0.4s; /*transition-lenght ved klik*/
  }
  /*Styling af kryds med klasse change*/
  .change .line1 {
    transform: rotate(45deg) translate(7px, 5px); /*Roter første linje*/
  }

  .change .line2 {
    transform: rotate(-45deg) translate(7px, -5px); /* Roter anden linje linje*/
  }

  /*STYLING AF ÅBEN MENU*/

  /*ændre header med klasse change*/

  header.change {
    background-color: var(--green); /*skift baggrundsfarve*/
    height: 100%; /*fyld hele skærmen*/
    overflow: hidden;
  }
  header.change .menubar,
  header.change .menubar .ikon_holder,
  header.change .menubar .left_row {
    border: none; /*fjern borders*/
    box-shadow: none; /*fjern shadow*/
  }
  header.change .menubar .visible_tab {
    display: none; /*fjern visible tabs*/
  }

  /****BURGER****/

  /*Primært Layout*/
  .change .burger {
    display: flex;
    flex-direction: column;
    position: fixed;
    bottom: 0;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 85.74%;
  }
  .burger_tab {
    border-top: 1px solid var(--Black, #060604);
    width: 100%;
    height: 16.6%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  /*Billeders positioner*/
  .news_img_1 {
    position: fixed;
    top: 15%;
    left: 12%;
  }
  .news_img_2 {
    position: fixed;
    top: 24%;
    left: 75%;
  }
  .news_img_3 {
    position: fixed;
    top: 44%;
    left: 5%;
  }
  .program_img_1 {
    position: fixed;
    top: 15%;
    left: 12%;
  }
  .program_img_2 {
    position: fixed;
    top: 54%;
    left: 5%;
  }
  .program_img_3 {
    position: fixed;
    top: 24%;
    left: 75%;
  }
  .tickets_img_1 {
    position: fixed;
    top: 31%;
    left: 72%;
  }
  .tickets_img_2 {
    position: fixed;
    top: 19%;
    left: 10%;
  }
  .map_img_1 {
    position: fixed;
    top: 14%;
    left: 70%;
  }
  .map_img_2 {
    position: fixed;
    top: 32%;
    left: 10%;
  }
  .map_img_3 {
    position: fixed;
    top: 67%;
    left: 84%;
  }
  .practical_img_1 {
    position: fixed;
    top: 16%;
    left: 14%;
  }
  .practical_img_2 {
    position: fixed;
    top: 24%;
    left: 74%;
  }
  .practical_img_3 {
    position: fixed;
    top: 67%;
    left: 2%;
  }
  .about_img_1 {
    position: fixed;
    top: 37%;
    left: 2%;
  }
  .about_img_2 {
    position: fixed;
    top: 17%;
    left: 74%;
  }

  /*Billeder vises og skrift bliver opacity ved hover*/
  .burger img {
    display: none;
    z-index: 100;
  }
  .burger .burger_tab:hover img {
    display: block; /*sørg for at billeder i den div der bliver hoveret på vises*/
  }

  .burger:hover .burger_tab {
    opacity: 0.5; /*sørg for at når man hover over burgeren får burger tabs 50% opacity */
  }
  .burger .burger_tab:hover {
    opacity: 1; /*sørg for at hvis man hover over en burger tab bliver opacity 100% - Nu vil KUN en tab være helt sort */
  }
  /**** BURGER MENU *****/
</style>
<script>
  // lav konstanter for burger ikon, burger menu og kryds ikon
  const icon = document.querySelector(".menu_ikon");
  const header = document.querySelector("header");
  const burger = document.querySelector("burger");

  // kald funktionen burgermenu, når der klikkes på burger eller kryds
  icon.addEventListener("click", burgermenu);

  // toggle class: hide og change (svarer til add ved klik på burgerikon og remove ved klik på kryds)
  // Hvis burgerikonet klikkes vises burgermenuen, og ligger sig ovenpå resten af indholdet
  // Hvis burgerikonet klikkes erstattes burgerikonet med krydset
  function burgermenu() {
    console.log("burger");
    icon.classList.toggle("change");
    header.classList.toggle("change");
    burger.classList.toggle("change");
  }
</script>
