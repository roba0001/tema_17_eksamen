<header class="class_header">
  <nav class="menubar">
    <div class="left_row">
      <a href="/index.html"
        ><img class="logo" src="/imgs/logo.png" alt="burger" /></a
      >
    </div>
    <div class="right_row">
      <a href="/news.html" class="visible_tab" id="news">News</a>
      <a href="/program.html" class="visible_tab" id="program">Program</a>
      <a href="/tickets.html" class="visible_tab" id="tickets">Tickets</a>
      <div class="ikon_holder">
        <div class="menu_ikon">
          <div class="line1"></div>
          <div class="line2"></div>
        </div>
      </div>
    </div>
  </nav>
  <nav>
    <div class="burger">
      <div class="burger_tab">
        <a href="/news.html" id="news">News</a>
        <img class="news_img_1" src="/imgs/burger/orange_1.png" alt="burger" />
        <img class="news_img_2" src="/imgs/burger/orange_2.png" alt="burger" />
        <img class="news_img_3" src="/imgs/burger/orange_3.png" alt="burger" />
      </div>
      <div class="burger_tab">
        <a href="/program.html" id="program">Program</a>
        <img class="program_img_1" src="/imgs/burger/blue_1.png" alt="burger" />
        <img class="program_img_2" src="/imgs/burger/blue_2.png" alt="burger" />
        <img class="program_img_3" src="/imgs/burger/blue_3.png" alt="burger" />
      </div>
      <div class="burger_tab">
        <a href="/tickets.html" id="tickets">Tickets</a>
        <img
          class="tickets_img_1"
          src="/imgs/burger/white_1.png"
          alt="burger"
        />
        <img
          class="tickets_img_2"
          src="/imgs/burger/white_2.png"
          alt="burger"
        />
      </div>
      <div class="burger_tab">
        <a href="/map.html" id="map">Map</a>
        <img class="map_img_1" src="/imgs/burger/red_1.png" alt="burger" />
        <img class="map_img_2" src="/imgs/burger/red_2.png" alt="burger" />
        <img class="map_img_3" src="/imgs/burger/red_3.png" alt="burger" />
      </div>
      <div class="burger_tab">
        <a href="/practical_information.html" id="practical_information"
          >Practical Information</a
