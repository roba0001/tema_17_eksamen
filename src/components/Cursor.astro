---
import "../style/styles.css";
---

<div class="inner_cursor"></div>
<div class="outer_cursor"></div>

<style>
  .inner_cursor {
    position: fixed;
    left: 10px;
    height: 10px;
    width: 10px;
    transform: translate(-50%, -50%);
    background: red;
    mix-blend-mode: difference;
    border-radius: 50%;
    pointer-events: none;
    transition: width 0.5s height 0.5s;
  }
  .inner_cursor {
    position: fixed;
    left: 10px;
    height: 25px;
    width: 25px;
    transform: translate(-50%, -50%);
    border: 1px solid black;
    mix-blend-mode: difference;
    border-radius: 50%;
    pointer-events: 0.1ms;
    transition: 0.1s;
  }
</style>
<script></script>
