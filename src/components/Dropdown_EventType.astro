---
import "../style/styles.css";
---

<select name="eventType" id="eventTypeSelector">
  <option value="allEventTypes" class="allEventTypesOption">All Event Types</option>
  <option value="talk" class="talkOption">Talk</option>
  <option value="networking" class="networkingOption">Networking</option>
  <option value="exhibition" class="exhibitionOption">Exhibition</option>
  <option value="workshop" class="workshopOption">Workshop</option>
</select>

<style>
  select {
    border-radius: 3.75rem;
    border: 1px solid var(--Dark-green, #21221a);
    background: var(--Dark-green, #21221a);
    color: white;
    display: flex;
    height: 1.5rem;
    padding: 0.1875rem 0rem;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
  }
</style>

<script>
  const topicSelector = document.getElementById("topicselector");

  topicSelector.addEventListener("change", function () {
    const selectedValue = this.value;
    filterTopics(selectedValue);
  });

  function filterTopics(topic) {
    console.log("Selected topic:", topic);
    if (topic === "branding") {
      console.log("test");
    }
  }
</script>
