---
import "../style/styles.css";
---

<select name="venue" id="venueSelector">
  <option value="allVenues" class="allVenuesOption">All Venues</option>
  <option value="huset" class="husetOption">Huset</option>
  <option value="blox" class="bloxOption">BLOX</option>
  <option value="blackDiamond" class="blackDiamondOption">The Black Diamond</option>
</select>

<style>
  select {
    border-radius: 3.75rem;
    border: 1px solid var(--Dark-green, #21221a);
    background: var(--Dark-green, #21221a);
    color: white;
    display: flex;
    height: 1.5rem;
    padding: 0.1875rem 0rem;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
  }
</style>

<script>
  const topicSelector = document.getElementById("topicselector");

  topicSelector.addEventListener("change", function () {
    const selectedValue = this.value;
    filterTopics(selectedValue);
  });

  function filterTopics(topic) {
    console.log("Selected topic:", topic);
    if (topic === "branding") {
      console.log("test");
    }
  }
</script>
