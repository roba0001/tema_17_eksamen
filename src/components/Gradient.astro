---
const { gradient_class } = Astro.props;
---

<div id="gradient" class={gradient_class}></div>

<style>
  /*MANUAL TIL BRUG PÅ SIDE*/
  /*Opret en ny klasse og tilføj følgende:*/
  /*STØRRELSE: definer width og height*/
  /*POSITION: definer postion med bottom og right*/
  /*Tilføj samme klasse til gradient i din fil*/
  #gradient {
    flex-shrink: 0;
    border-radius: 1263px;
    z-index: -1;
    background: radial-gradient(
      50.06% 50% at 50.06% 50%,
      var(--green) 0%,
      var(--off_white) 100%
    );
  }
  .practical1 {
    width: 800px;
    height: 800px;
    bottom: 100px;
    right: 1000px;
    z-index: -1;
    position: fixed;
  }
  .practical2 {
    width: 800px;
    height: 800px;
    bottom: -200px;
    right: -100px;
    z-index: -1;
    position: fixed;
  }
  .program_sw {
    position: absolute;
    width: 1900px;
    height: 1500px;
    top: -700px;
    right: -650px;
  }

  .news_sw {
    position: absolute;
    width: 800px;
    height: 800px;
    top: 22rem;
    right: 0;
  }
  .news_1 {
    width: 800px;
    height: 800px;
    top: 800px;
    right: -300px;
    z-index: -1;
    position: absolute;
    display: none;
  }
  .news_2 {
    width: 1000px;
    height: 1000px;
    top: 10px;
    left: -200px;
    z-index: -1;
    position: absolute;
    display: none;
  }
  .news_3 {
    width: 850px;
    height: 600px;
    top: 1520px;
    left: 30px;
    z-index: -1;
    position: absolute;
    display: none;
  }
  @media (min-width: 800px) {
    .program_sw {
      width: 1900px;
      height: 1500px;
      top: -700px;
      right: -300px;
    }

    .news_sw {
      position: absolute;
      width: 800px;
      height: 800px;
      top: 10rem;
      right: 46rem;
    }
    .news_sw2 {
      position: absolute;
      width: 800px;
      height: 800px;
      top: 50rem;
      right: 3rem;
    }
    .news_1 {
      width: 800px;
      height: 800px;
      top: 800px;
      right: -300px;
      z-index: -1;
      position: absolute;
    }
    .news_2 {
      width: 1000px;
      height: 1000px;
      top: 10px;
      left: -200px;
      z-index: -1;
      position: absolute;
    }
    .news_3 {
      width: 850px;
      height: 600px;
      top: 1520px;
      left: 30px;
      z-index: -1;
      position: absolute;
    }
  }
</style>
