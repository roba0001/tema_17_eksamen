---
import CardCategory from "./Card_Category.astro";
import "../style/styles.css";
const { size_class, type, date, title, image } = Astro.props;
---

<a class={size_class} id="container" href="/program_singleview.html">
  <div class="top">
    <img class="news_img" src={`/public/imgs/news/${image}`} alt="news_image" />
    <div class="top_overlay">
      <CardCategory class="category" className="news" text={type} />
    </div>
  </div>
  <div class="bottom">
    <p class="small_p">( {date} )</p>
    <p>{title}</p>
  </div>
</a>

<style>
  .column_2 .bottom {
    height: 40px;
  }
  .column_2_row_2 p {
    font-size: 20px;
  }
  .column_2_row_2 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .column_1 {
    grid-column: span 1;
    grid-row: span 1;
  }
  .column_2 {
    grid-column: span 2;
    grid-row: span 1;
  }
  .row_2 {
    grid-row: span 2;
  }
  /**Lav klasser til de forskellige widths ved at bruge grid span */

  .column_2_row_2 .small_p,
  .small_p {
    font-family: "Red Hat Display", sans-serif;
    font-size: 12px;
    line-height: normal;
    font-weight: 600;
    font-style: normal;
    color: var(--black_opacity);
  }
  #container {
    display: flex;
    flex-direction: column;
    background-color: rgba(207, 255, 92, 0.5);
    border-radius: 30px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    height: 100%;
    min-height: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }
  .bottom {
    min-height: 0;
    padding: 15px;
    display: flex;
    gap: 5px;
    flex-direction: column;
    height: 70px;
    flex-shrink: 0; /* prevent shrinking */
  }
  #button img {
    transform: rotate(45deg);
    width: 80px;
    transition: 1s;
  }
  #button:hover img {
    transform: rotate(0deg);
  }
  #button {
    display: flex;
    justify-content: flex-end;
  }
  .top {
    flex: 1 1 auto;
    min-height: 0; /* important for child img scaling */
    position: relative;
    display: flex;
  }

  .news_img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .top_overlay {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .date {
    padding-left: 15px;
    padding-bottom: 5px;
    color: var(--green, #cfff5c);
    /* Desktop/H3 */
    font-family: "General Sans";
    font-size: 18px;
    font-weight: 600;
    line-height: normal;
  }

  @media (max-width: 800px) {
    #container {
      flex-direction: row;
    }
    .bottom {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-left: 15px;
      padding-top: 15px;
      padding-right: 0px;
      padding-bottom: 0px;
      height: 50px;
      flex-shrink: 0; /* prevent shrinking */
    }
    .news_img {
      border-top-right-radius: 0px;
    }
    .date {
      padding-bottom: 15px;
    }
  }
</style>
