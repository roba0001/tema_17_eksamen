---
import "../style/styles.css";
import Arrow from "./Arrow.astro";
import ProgramCard from "./Program_Card.astro";
import TextAndArrow from "./Text_And_Arrow.astro";
import X from "./X.astro";

const data = await fetch(
  "https://hdwrzbktzyoytozzhhrw.supabase.co/rest/v1/events?date=eq.2025-09-04",
  {
    method: "GET",
    headers: {
      apikey:
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhkd3J6Ymt0enlveXRvenpoaHJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDY4MDIxMzYsImV4cCI6MjA2MjM3ODEzNn0.3w77RtPOv0ngqCNY7WUomweHq-aqoPC2LlEKmQBj1H0",
    },
  }
).then((res) => res.json());

console.log("data:", data);
---

<section class="program_row_wrapper">
  <section class="program_row_closed visible">
    <h1>04.09</h1>
    <div class="arrow">
      <Arrow />
    </div>
  </section>

  <section class="program_row_open">
    <img
      class="stretched_number_svg"
      src="/public/imgs/Program/numbers/04.svg"
      alt="stretched 04"
    />
    <div class="x_and_scroll_flex">
      <h1 class="mobile_date">04.09</h1>

      <X />

      <div class="scroll_section">
        {
          data.map((data) => {
            return (
              <>
                <ProgramCard data={data} />
              </>
            );
          })
        }
      </div>
    </div>
  </section>
</section>

<style>
  .program_row_wrapper {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  /* mobile */
  .x_and_scroll_flex {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
  }
  .ex {
    justify-self: flex-end;
  }
  .program_row_closed {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* width: auto; */
    padding: 0 20px;
    border-color: var(--black);
    border-width: 1px;
    border-bottom-style: solid;
    border-top-style: solid;
  }
  .program_row_open {
    padding: 20px;
    border-color: var(--black);
    border-width: 1px;
    border-bottom-style: solid;
    border-top-style: solid;
  }

  .stretched_number_svg {
    display: none;
  }

  .scroll_section {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    gap: 0.9375rem;
    overflow: hidden;
    overflow-x: scroll;
  }

  /* desktop */
  @media (min-width: 800px) {
    .mobile_date {
      display: none;
    }
    .stretched_number_svg {
      display: block;
    }
    h1 {
      height: fit-content;
    }
    .program_row_closed,
    .program_row_open {
      border-top-style: solid;
      border-width: 1px;
    }
    .program_row_open {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4rem;
    }

    .x_and_scroll_flex {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      overflow-x: scroll;
    }

    .ex {
      align-self: flex-end;
    }

    .scroll_section {
      display: flex;
      gap: 2rem;
      overflow: hidden;
      overflow-x: scroll;
    }

    .program_row_closed {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 7.6rem;
      padding: 0 2.5rem;
    }
  }
  /* hidden */
  .program_row_open,
  .program_row_closed {
    overflow: hidden;
    opacity: 0;
    max-height: 0;
    transform: translateY(-2rem);
    transition:
      opacity 0.4s ease,
      max-height 0.6s ease,
      transform 0.4s ease;
  }

  /* open and visible */
  .visible {
    opacity: 1;
    max-height: 1000px;
    transform: translateY(0);
  }

  /* smoother closing animation */
  .closing {
    opacity: 0;
    max-height: 0;
    transform: translateY(-2rem);
  }

  .program_row_wrapper {
    max-width: 100%;
  }
</style>

<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const rows = document.querySelectorAll(".program_row_wrapper");

    rows.forEach((wrapper) => {
      const arrow = wrapper.querySelector(".arrow");
      const ex = wrapper.querySelector(".ex");
      const openRow = wrapper.querySelector(".program_row_open");
      const closedRow = wrapper.querySelector(".program_row_closed");

      arrow.addEventListener("click", () => {
        closedRow.classList.remove("visible");
        openRow.classList.remove("closing");
        requestAnimationFrame(() => {
          openRow.classList.add("visible");
        });
      });

      ex.addEventListener("click", () => {
        openRow.classList.add("closing"); // trigger transition
        setTimeout(() => {
          openRow.classList.remove("visible");
          openRow.classList.remove("closing");
          closedRow.classList.add("visible");
        }, 400); // match transition duration
      });
    });
  });
</script>
