---
import "../style/styles.css";
---

<div class="carousel">
  <!-- Slideshow container -->
  <div class="slideshow-container">
    <!-- Full-width images with number and caption text -->
    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/arjun_malik.webp" alt="Arjun Malik" />
      <p class="text">Arjun Malik</p>
    </div>

    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/elena_motta.webp" alt="Elena Motta" />
      <p class="text">Elena Motta</p>
    </div>

    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/jules_renner.webp" alt="Jules Renner" />
      <p class="text">Jules Renner</p>
    </div>
    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/lena_alvarez.webp" alt="Lena Alvarez" />
      <p class="text">Lena Alvarez</p>
    </div>
    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/nico_delgado.webp" alt="Nico Delgado" />
      <p class="text">Nico Delgado</p>
    </div>
    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/sam_taylor.webp" alt="Sam Taylor" />
      <p class="text">Sam Taylor</p>
    </div>
    <div class="mySlides fade">
      <img src="/imgs/speakers/caroussel/takumi_hara.webp" alt="Takumi Hara" />
      <p class="text">Takumi Hara</p>
    </div>

    <!-- Next and previous buttons -->
  </div>
  <div class="arrow_container">
    <img class="arrow next" src="/imgs/Program/numbers/arrow.svg" alt="Next Arrow" />
    <img class="arrow prev" src="/imgs/Program/numbers/arrow.svg" alt="Previous Arrow" />
  </div>
</div>

<style>
  .carousel {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin: 10rem 0;
    gap: 5rem;
  }
  img {
    height: 400px;
  }
  img.inactive {
    height: 300px;
    width: auto;
    opacity: 50%;
  }

  /* Slideshow container */
  .slideshow-container {
    width: 1000px;
    display: flex;
    justify-content: space-between;
  }

  /* Hide the images by default */
  .mySlides {
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Next & previous buttons */
  .prev,
  .next {
    cursor: pointer;
    width: auto;
    margin-top: -22px;
    padding: 16px;
    color: black;
    font-weight: bold;
    font-size: 18px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    /* user-select: none; */
  }

  /* Position the "next button" to the right */
  /* .next {
    right: 0;
    border-radius: 3px 0 0 3px;
  } */

  .arrow_container {
    display: flex;
    gap: 10rem;
  }
  .arrow {
    width: 35px;
    height: 35px;
  }
  .prev {
    transform: rotate(-45deg);
  }
  .next {
    transform: rotate(135deg);
  }

  /* On hover, add a black background color with a little bit see-through */
  .prev:hover,
  .next:hover {
    /* transform: scaleX(1.5); */
  }

  /* Caption text */
  .text {
    color: black;
    font-size: 15px;
    padding: 8px 12px;

    text-align: center;
  }

  .active,
  .dot:hover {
    background-color: #717171;
  }

  /* Fading animation */
  .fade {
    animation-name: fade;
    animation-duration: 1.5s;
  }

  @keyframes fade {
    from {
      opacity: 0.4;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    let slideIndex = 1;
    const prevBtn = document.querySelector(".prev");
    const nextBtn = document.querySelector(".next");

    prevBtn.addEventListener("click", () => plusSlides(1));
    nextBtn.addEventListener("click", () => plusSlides(-1));

    function plusSlides(n) {
      slideIndex += n;
      showSlides(slideIndex);
    }

    function showSlides(n) {
      const slides = document.getElementsByClassName("mySlides");
      if (n > slides.length) slideIndex = 1;
      if (n < 1) slideIndex = slides.length;

      for (let i = 0; i < slides.length; i++) {
        const img = slides[i].querySelector("img");
        const text = slides[i].querySelector(".text");
        if (img && text) {
          img.classList.add("inactive");
          text.style.display = "none";
        }
      }

      const currentSlide = slides[slideIndex - 1];
      if (!currentSlide) return;
      const currentImg = currentSlide.querySelector("img");
      const currentText = currentSlide.querySelector(".text");

      if (currentImg && currentText) {
        currentImg.classList.remove("inactive");
        currentText.style.display = "block";
      }
    }

    // Initial show
    showSlides(slideIndex);
  });
</script>
