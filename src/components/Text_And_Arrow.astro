---
import Arrow from "./Arrow.astro";
const { text } = Astro.props;
---

<div class="container">
  <h2>{text}</h2>
  <img class="pracical_arrow" src="/imgs/arrow.svg" alt="arrow" />
</div>

<style>
  .container {
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    padding: 20px 0px;
    border-top: 1px solid var(--Black, #060604);
  }
  img {
    transform: rotate(45deg) !important;
    display: block;
    width: 80px;
  }
  .container:hover img {
    transform: rotate(0deg) !important;
  }

  .active .container img {
    transform: rotate(0deg) !important;
  }
</style>
