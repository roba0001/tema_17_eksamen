---
import "../style/styles.css";
import Arrow from "./Arrow.astro";
const { text } = Astro.props;
const { text_arrow_class } = Astro.props;
---

<div class="container" class={text_arrow_class}>
  <h2>{text}</h2>
  <Arrow arrow_class="downleft" />
</div>

<style>
  .container {
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
  }
  .container:hover #downleft {
    transform: rotate(0deg);
  }
</style>
