---
const { headline, address, about, more, image, venue_class } = Astro.props;
---

<div id="container" class={venue_class}>
  <div>
    <h3>{headline}</h3>
    <p>( {address} )</p>
    <p>{about}</p>
    <p>{more}</p>
  </div>
  <img class={headline} src={image} alt="burger" />
</div>

<style>
  #container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 40px;
  }
</style>
