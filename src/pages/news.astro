---
import Skelet from "../layouts/Skelet.astro";
import Gradient from "../components/Gradient.astro";
import NewsCards from "../components/News_Cards.astro";
import "../style/styles.css";
---

<Skelet>
  <main>
    <Gradient gradient_class="news_1" />
    <Gradient gradient_class="news_2" />
    <Gradient gradient_class="news_3" />
    <h1>News</h1>
    <div class="news_grid">
      <NewsCards
        size_class="column_2_row_2"
        image="1/vid_1.gif"
        type="Trends & Insights"
        date="01.02.04"
        title="Why Everyone’s Talking About Motion Again"
      />
      <NewsCards
        size_class="column_1 flip"
        image="14/img_1.webp"
        type="Festival Tips"
        date="01.03.04"
        title="What to See on Day 1: Talks, Tours, and Tips"
      />
      <NewsCards
        size_class="row_2"
        image="3/img_1.webp"
        type="Interview"
        date="13.02.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1 flip"
        image="12/img_1.webp"
        type="Spotlight"
        date="01.03.04"
        title="Branding with Purpose: Behind the Message-Driven Campaigns"
      />
      <NewsCards
        size_class="row_2"
        image="5/img_1.webp"
        type="Spotlight"
        date="01.03.04"
        title="Why Copenhagen Is Europe’s Quiet Creative Powerhouse"
      />
      <NewsCards
        size_class="column_2 flip"
        image="10/img_1.webp"
        type="Trends & Insights"
        date="01.03.04"
        title="Why Responsive Web Design Still Matters"
      />
      <NewsCards
        size_class="column_1"
        image="9/img_1.webp"
        type="Festival Tips"
        date="01.03.04"
        title="Visual Impact Festival is Redefining How Creatives Connect"
      />
      <NewsCards
        size_class="column_1 flip"
        image="4/vid_1.gif"
        type="Trends & Insights"
        date="01.03.04"
        title="Animation That Sells: How Stylized Movement Drives Engagement"
      />
      <NewsCards
        size_class="column_1"
        image="2/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Sara Coleman Brings Bold Branding Energy to the Stage"
      />
      <NewsCards
        size_class="row_2 flip"
        image="7/vid_1.gif"
        type="Spotlight"
        date="01.03.04"
        title="A Future in Motion: Designing a Greener Tomorrow"
      />
      <NewsCards
        size_class="column_1"
        image="13/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="3D in Motion: How Elena Motta Brings Objects to Life"
      />
      <NewsCards
        size_class="column_1 flip"
        image="6/img_1.webp"
        type="Industry News"
        date="01.03.04"
        title="How AI is Revolutionizing the Creative Process"
      />
      <NewsCards
        size_class="column_1"
        image="11/img_1.webp"
        type="Festival Tips"
        date="01.03.04"
        title="Sketch Café: Where Designers Start Their Day with Coffee and Ideas"
      />
    </div>
  </main>
</Skelet>

<style>
  .news_grid > * {
    height: 100%;
  }
  main {
    margin: 120px 20px;
  }
  .news_grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 10px; /* <-- fixed row height */
    grid-auto-flow: row;
    gap: 20px;
    margin-top: 40px;
  }
  @media (min-width: 800px) {
    .news_grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(5, 250px); /* <-- fixed row height */
    }
    main {
      margin: 120px 40px;
    }
  }
</style>
