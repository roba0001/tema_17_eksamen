---
import Skelet from "../layouts/Skelet.astro";
import Gradient from "../components/Gradient.astro";
import NewsCards from "../components/News_Cards.astro";
import "../style/styles.css";
---

<Skelet>
  <main>
    <Gradient gradient_class="news_1" />
    <Gradient gradient_class="news_2" />
    <Gradient gradient_class="news_3" />
    <h1>News</h1>
    <div class="news_grid">
      <NewsCards
        size_class="column_2_row_2"
        image="1/vid_1.gif"
        type="Insights"
        date="01.02.04"
        title="Why Everyone’s Talking About Motion Again"
      />
      <NewsCards
        size_class="column_1"
        image="11/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="row_2"
        image="3/img_1.webp"
        type="Festival Tips"
        date="13.02.04"
        title="Why Everyone’s Talking About Motion Again"
      />
      <NewsCards
        size_class="column_1"
        image="12/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="row_2"
        image="5/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_2"
        image="10/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1"
        image="9/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1"
        image="4/vid_1.gif"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1"
        image="2/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="row_2"
        image="7/vid_1.gif"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1"
        image="13/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1"
        image="6/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
      <NewsCards
        size_class="column_1"
        image="14/img_1.webp"
        type="Interview"
        date="01.03.04"
        title="Video That Moves: Jamal Rivers on Creating Impact with Style"
      />
    </div>
  </main>
</Skelet>

<style>
  .news_grid > * {
    height: 100%;
  }
  main {
    margin: 120px 20px;
  }
  .news_grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(14, 300px); /* <-- fixed row height */
    grid-auto-flow: row;
    gap: 40px;
    margin-top: 40px;
  }
  @media (min-width: 800px) {
    .news_grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(5, 250px); /* <-- fixed row height */
      gap: 20px;
      margin-top: 40px;
    }
    main {
      margin: 120px 40px;
    }
  }
</style>
