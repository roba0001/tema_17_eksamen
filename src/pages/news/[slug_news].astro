---
import Skelet from "../../layouts/Skelet.astro";
import CardCategory from "../../components/Card_Category.astro";
import "../../style/styles.css";
import ProgramCard from "../../components/Program_Card.astro";
import Gradient from "../../components/Gradient.astro";

export async function getStaticPaths() {
  const data = await fetch("https://hdwrzbktzyoytozzhhrw.supabase.co/rest/v1/News", {
    method: "GET",
    headers: {
      apikey:
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhkd3J6Ymt0enlveXRvenpoaHJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDY4MDIxMzYsImV4cCI6MjA2MjM3ODEzNn0.3w77RtPOv0ngqCNY7WUomweHq-aqoPC2LlEKmQBj1H0",
    },
  }).then((response) => response.json());
  return data.map((news) => {
    return {
      // laver en url for hver side med et unikt slug
      params: { slug_news: news.slug_news },
      //   sender props med ned til undersiden, hvor myData har værdien af post
      props: { myData: news },
    };
  });
}
// laver en constant med den data der er fra den unikke slug, her samles myData op
const { myData } = Astro.props;
---

<Skelet>
  <section class="news_singleview_grid">
    <a href="../news" class="back_arrow_section">
      <img data-cursor="fill" src="/imgs/Program/numbers/arrow.svg" alt="arrow" />
    </a>

    <section class="left_img_column">
      <img
        id="changingImageDesktop"
        src="/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img1.webp"
        alt="Article Image"
      />
    </section>

    <section class="right_txt_column">
      <div class="news_date_and_author_flex">
        <p>Date: {myData.date}</p>
        <p>Author: {myData.author}</p>
      </div>
      <div class="news_topics_flex">
        <CardCategory className="newsNoMargin" text={myData.topic} />
        <CardCategory className="newsNoMargin" text={myData.type} />
      </div>
      <div class="news_txt">
        <h2>
          {myData.title}
        </h2>
        <p>
          {myData.text}
        </p>
        <Gradient gradient_class="news_sw" />
        <img id="changingImageMobile" src={`/imgs/News${myData.image_1}`} alt="Article Image" />
        {myData.text_2}
      </div>
      <div class="news_event_details">
        <p>
          Stay tuned for more updates and behind-the-scenes highlights from this year's Design
          Festival by signing up for our newsletter.
        </p>
        <Gradient gradient_class="news_sw2" />
      </div>
    </section>
  </section>
</Skelet>

<style>
  /* MOBILE */

  img {
    width: 20rem;
  }

  .news_singleview_grid {
    display: flex;
    flex-direction: column;
    margin-top: 120px;
  }
  .back_arrow_section {
    padding: 20px;
    border-width: 1px;
    border-bottom-style: solid;
    img {
      width: 25px;
      transform: rotate(135deg);
    }
  }
  .news_date_and_author_flex,
  .news_topics_flex {
    display: flex;
  }
  .news_date_and_author_flex {
    border-bottom-style: solid;
    border-width: 1px;

    p {
      padding: 10px 20px;
    }
    & > p:first-child {
      border-right-style: solid;
      border-width: 1px;
    }
  }

  .news_topics_flex {
    padding: 20px;
    padding-bottom: 0;
    gap: 15px;
  }

  #changingImageDesktop,
  .news_sw2 {
    display: none;
  }

  #changingImageMobile {
    height: 17rem;
    width: auto;
    margin: 2rem 20px;
    border-radius: 30px;
    position: relative;
    left: 40%;
  }

  .news_txt {
    padding: 1.5rem 20px;

    h2 {
      margin-bottom: 1rem;
    }
    p {
      margin-bottom: 1.5rem;
    }
    p:last-of-type {
      margin-bottom: 0rem;
    }
  }
  .news_event_details {
    margin: 20px;
    margin-top: 0;

    img {
      margin: 1rem 0;
    }
  }

  /* DESKTOP */
  @media (min-width: 800px) {
    #changingImageMobile {
      display: none;
    }
    #changingImageDesktop {
      display: block;
    }
    .back_arrow_section {
      grid-column: 1/-1;
      padding: 20px 40px;

      img {
        width: 35px;
        transform: rotate(135deg);
      }
    }
    .news_singleview_grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      grid-template-rows: auto 1fr;
    }

    /* ----------------------------LEFT COLUMN---------------------------- */
    .left_img_column {
      display: flex;
      justify-content: center;
      border-width: 1px;
      border-right-style: solid;
      img {
        height: 25rem;
        width: auto;
        margin: 2rem 0;
        border-radius: 30px;
        position: sticky;
        top: 10%;
      }
    }

    /* ----------------------------RIGHT COLUMN---------------------------- */
    .news_date_and_author_flex {
      p {
        padding: 10px 40px;
      }
    }
    .porgramCard_placehoder {
      width: 15rem;
      height: auto;
      border-radius: 30px;
    }

    .news_topics_flex {
      padding: 20px 40px 0px 40px;
    }

    .news_txt {
      padding: 2.5rem 40px 2.5rem 40px;

      h2 {
        margin-bottom: 2rem;
      }
    }

    .news_event_details {
      margin: 0 40px 20px 40px;

      img {
        margin: 1.5rem 0;
      }
    }
  }
</style>

<script>
  window.addEventListener("scroll", () => {
    const imgDesktop = document.getElementById("changingImageDesktop");
    const imgMobile = document.getElementById("changingImageMobile");
    const scrollY = window.scrollY;

    if (scrollY > 500) {
      imgDesktop.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img1.webp";
      imgMobile.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img1.webp";
    } else if (scrollY > 400) {
      imgDesktop.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img2.webp";
      imgMobile.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img2.webp";
    } else if (scrollY > 300) {
      imgDesktop.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img3.webp";
      imgMobile.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img3.webp";
    } else if (scrollY > 200) {
      imgDesktop.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img4.webp";
      imgMobile.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img4.webp";
    } else {
      imgDesktop.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img5.webp";
      imgMobile.src = "/imgs/Program/day-1/Designing-Brands-in-a-Noisy-World/img5.webp";
    }
  });
</script>
