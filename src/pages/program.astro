---
import Skelet from "../layouts/Skelet.astro";
import Gradient from "../components/Gradient.astro";

import "../style/styles.css";
import ProgramRow04 from "../components/Program_Row_04.astro";
import ProgramRow05 from "../components/Program_Row_05.astro";
import ProgramRow06 from "../components/Program_Row_06.astro";
import ProgramRow07 from "../components/Program_Row_07.astro";
import DropdownTopic from "../components/Dropdown_Topic.astro";
import DropdownVenue from "../components/Dropdown_Venue.astro";
import DropdownEventType from "../components/Dropdown_EventType.astro";
---

<Skelet>
  <div class="program_wrapper">
    <h1>Program</h1>
    <div class="flex">
      <DropdownTopic />
      <DropdownEventType />
      <DropdownVenue />
    </div>
    <ProgramRow04 />
    <ProgramRow05 />
    <ProgramRow06 />
    <ProgramRow07 />
  </div>
</Skelet>

<style>
  .flex {
    display: flex;
    gap: 2rem;
    margin: 1rem 40px;
  }
  #topicselector {
    margin: 10rem 0;
    border-radius: 3.75rem;
    border: 1px solid var(--Dark-green, #21221a);
    background: var(--Dark-green, #21221a);
    color: white;
    display: flex;
    height: 1.5rem;
    padding: 0.1875rem 0rem;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
  }
  h1 {
    margin: 120px 2.5rem 2.5rem 2.5rem;
  }
  section {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
</style>

<script>
  const topicSelector = document.getElementById("topicselector");

  topicSelector.addEventListener("change", function () {
    const selectedValue = this.value;
    filterTopics(selectedValue);
  });

  function filterTopics(topic) {
    console.log("Selected topic:", topic);
    if (topic === "branding") {
      console.log("test");
    }
  }
</script>
